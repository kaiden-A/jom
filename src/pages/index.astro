---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PolaroidStack from "../components/site/PolaroidStack.astro";
import { roadmap } from "../data/roadmap";

const lessons = (await getCollection("lessons", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.lesson - b.data.lesson,
);

const features = [
  {
    title: "Faham dulu, kod kemudian",
    body: "Setiap lesson start dengan kenapa dan flow dia. Baru kita masuk kod. Sebab kod tu cuma alat.",
    icon: "bulb",
  },
  {
    title: "BM santai je",
    body: "Tak payah translate dalam kepala. Baca macam kawan yang duduk sebelah kau menjelaskan.",
    icon: "chat",
  },
  {
    title: "Demo yang boleh klik",
    body: "Bukan gambar screenshot. Try sendiri, tekan sendiri, paham sendiri. Baru melekat.",
    icon: "click",
  },
] as const;
---

<BaseLayout title="Jom Mula — Belajar build website, satu-satu">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="mx-auto grid w-full max-w-6xl items-center gap-10 px-4 pt-12 pb-16 sm:px-6 sm:pt-20 lg:grid-cols-[1.1fr_1fr] lg:gap-14"
    >
      <div>
        <span
          class="border-line shadow-clay-xs inline-flex items-center gap-2 rounded-full border bg-white px-3.5 py-1.5 text-xs font-bold"
        >
          <span class="bg-mint relative flex size-2 rounded-full">
            <span
              class="bg-mint absolute inline-flex h-full w-full animate-ping rounded-full opacity-60"
            ></span>
          </span>
          Lesson 1 dah keluar
        </span>
        <h1
          class="font-display mt-6 text-4xl leading-[1.08] font-semibold sm:text-6xl"
        >
          Belajar build website, <span class="hl">satu-satu</span>.
        </h1>
        <p class="text-ink-soft mt-6 max-w-xl text-lg leading-relaxed">
          Tutorial santai dalam BM. Aku terangkan bentuk dan flow dulu, lepas
          tu baru kita kod sama-sama. Takde jargon berbelit, janji.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/lessons/gallery-blog" class="btn btn-primary">
            Mula Lesson 1
            <svg
              class="size-4"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 10h11M11 5l5 5-5 5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="#lessons" class="btn btn-ghost">Tengok semua lesson</a>
        </div>
        <p class="text-ink-soft mt-7 text-sm font-bold">
          Projek pertama: gallery blog —
          <span class="text-ink">React · Express · Neon · Cloudflare R2</span>
        </p>
      </div>
      <PolaroidStack />
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-3">
      {
        features.map((f) => (
          <div class="clay p-6">
            <span class="bg-brand-soft text-brand-deep grid size-11 place-items-center rounded-2xl">
              {f.icon === "bulb" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M9 18h6M10 21h4M12 3a6 6 0 00-3.5 10.9c.5.4.8 1 .9 1.6l.1.5h5l.1-.5c.1-.6.4-1.2.9-1.6A6 6 0 0012 3z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
              {f.icon === "chat" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M21 12a8 8 0 01-8 8H4l2.4-2.4A8 8 0 1121 12z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path d="M9 11h6M9 14h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              )}
              {f.icon === "click" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M9 4v3M4 9h3M6.2 6.2l2 2M15.5 15.5L20 20l-6.5-2.2L12 21l-3-7.5L5 12l7.5-3 3 6.5z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
            </span>
            <h2 class="font-display mt-4 text-lg font-semibold">{f.title}</h2>
            <p class="text-ink-soft mt-2 text-sm leading-relaxed">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Lessons -->
  <section id="lessons" class="mx-auto mt-20 w-full max-w-6xl scroll-mt-24 px-4 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="font-display text-brand-deep text-xs font-semibold tracking-widest uppercase">
          Lessons
        </p>
        <h2 class="font-display mt-2 text-2xl font-semibold sm:text-3xl">
          Mula dari sini
        </h2>
      </div>
      <p class="text-ink-soft hidden text-sm font-bold sm:block">
        {lessons.length} lesson dah keluar · {roadmap.length} dalam queue
      </p>
    </div>

    <div class="mt-8">
      {
        lessons.map((lesson) => (
          <a
            href={`/lessons/${lesson.data.slug}`}
            class="clay group hover:shadow-clay grid gap-6 p-6 transition-transform duration-200 hover:-translate-y-1 sm:p-8 lg:grid-cols-[auto_1fr_auto] lg:items-center"
          >
            <span class="font-display bg-brand-soft text-brand-deep grid size-16 place-items-center rounded-2xl text-2xl font-semibold">
              {String(lesson.data.lesson).padStart(2, "0")}
            </span>
            <span>
              <span class="flex flex-wrap items-center gap-2">
                <span class="font-display text-xl font-semibold sm:text-2xl">
                  {lesson.data.title}
                </span>
                <span class="bg-mint/25 text-mint-deep rounded-full px-2.5 py-0.5 text-xs font-bold">
                  Boleh mula sekarang
                </span>
              </span>
              <span class="text-ink-soft mt-2 block max-w-2xl text-sm leading-relaxed sm:text-base">
                {lesson.data.summary}
              </span>
              <span class="text-ink-soft/80 mt-3 block text-xs font-bold">
                {lesson.data.duration} · {lesson.data.tags.join(" · ")}
              </span>
            </span>
            <span class="btn btn-primary hidden lg:inline-flex">
              Baca
              <svg
                class="size-4"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M4 10h11M11 5l5 5-5 5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Roadmap -->
  <section id="roadmap" class="mx-auto mt-20 w-full max-w-6xl scroll-mt-24 px-4 sm:px-6">
    <p class="font-display text-brand-deep text-xs font-semibold tracking-widest uppercase">
      Roadmap
    </p>
    <h2 class="font-display mt-2 text-2xl font-semibold sm:text-3xl">
      Apa yang akan datang
    </h2>
    <p class="text-ink-soft mt-3 max-w-2xl text-sm leading-relaxed sm:text-base">
      Selepas Lesson 1, kita akan bina projek tu betul-betul — satu step pada
      satu masa.
    </p>

    <ol class="border-line mt-8 space-y-4 border-l-2 border-dashed pl-6 sm:pl-8">
      {
        roadmap.map((item) => (
          <li class="relative">
            <span class="border-line text-ink-soft font-display absolute -left-[35px] grid size-6 place-items-center rounded-full border-2 bg-white text-[10px] font-semibold sm:-left-[43px]">
              {item.n}
            </span>
            <div class="clay flex flex-col gap-1 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="font-display text-base font-semibold">{item.title}</p>
                <p class="text-ink-soft mt-0.5 text-sm">{item.blurb}</p>
              </div>
              <span class="text-ink-soft/70 mt-2 shrink-0 rounded-full bg-paper px-3 py-1 text-xs font-bold sm:mt-0">
                Akan datang
              </span>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- CTA -->
  <section class="mx-auto mt-20 w-full max-w-6xl px-4 sm:px-6">
    <div class="bg-ink relative overflow-hidden rounded-[2rem] px-6 py-12 text-center sm:px-12 sm:py-16">
      <div class="bg-brand/40 absolute -top-24 -left-24 size-64 rounded-full blur-3xl"></div>
      <div class="bg-accent/30 absolute -right-24 -bottom-24 size-64 rounded-full blur-3xl"></div>
      <div class="relative">
        <p class="font-display text-sun text-xs font-semibold tracking-widest uppercase">
          Ready?
        </p>
        <h2 class="font-display mt-3 text-3xl font-semibold text-white sm:text-4xl">
          Jom mula. Jangan tunggu rasa "cukup ilmu".
        </h2>
        <p class="text-brand-soft/90 mx-auto mt-4 max-w-xl text-sm leading-relaxed sm:text-base">
          Lesson 1 ambik masa dalam 5 minit je. Habiskan, dan kau akan tau
          exactly apa yang kita nak bina.
        </p>
        <a href="/lessons/gallery-blog" class="btn btn-primary mt-8">
          Baca Lesson 1
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
