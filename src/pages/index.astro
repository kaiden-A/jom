---
import BaseLayout from "../layouts/BaseLayout.astro";
import PolaroidStack from "../components/site/PolaroidStack.astro";
import { projects } from "../data/projects";
import {
  getPublishedLessons,
  lessonUrl,
  lessonsOf,
} from "../utils/lessons";

const lessons = await getPublishedLessons();
const groups = projects.map((project) => ({
  project,
  published: lessonsOf(lessons, project.slug),
}));
const availableGroups = groups.filter(
  (g) => g.project.status === "available" && g.published.length > 0,
);
const firstLesson = lessons[0];
const firstLessonHref = firstLesson
  ? lessonUrl(firstLesson)
  : "/projek/gallery-blog/gambaran-besar";

const features = [
  {
    title: "Understand first, code later",
    body: "Every lesson starts with the why and the flow. Then we get into code. Because code is just a tool.",
    icon: "bulb",
  },
  {
    title: "Casual, no jargon",
    body: "No translating in your head. It reads like a friend sitting next to you, explaining things.",
    icon: "chat",
  },
  {
    title: "Demos you can click",
    body: "Not screenshots. Try it yourself, press it yourself, get it yourself. That's what sticks.",
    icon: "click",
  },
] as const;
---

<BaseLayout title="Jom Mula — Learn to build websites, one step at a time">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="mx-auto grid w-full max-w-6xl items-center gap-10 px-4 pt-12 pb-16 sm:px-6 sm:pt-20 lg:grid-cols-[1.1fr_1fr] lg:gap-14"
    >
      <div>
        <span
          class="border-line shadow-clay-xs inline-flex items-center gap-2 rounded-full border bg-white px-3.5 py-1.5 text-xs font-bold"
        >
          <span class="bg-mint relative flex size-2 rounded-full">
            <span
              class="bg-mint absolute inline-flex h-full w-full animate-ping rounded-full opacity-60"
            ></span>
          </span>
          {lessons.length} lessons out now
        </span>
        <h1
          class="font-display mt-6 text-4xl leading-[1.08] font-semibold sm:text-6xl"
        >
          Learn to build websites, <span class="hl">one step</span> at a time.
        </h1>
        <p class="text-ink-soft mt-6 max-w-xl text-lg leading-relaxed">
          A laid-back tutorial in plain English. Every project is broken into
          small lessons — understand the flow first, then we write the code
          together.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={firstLessonHref} class="btn btn-primary">
            Start learning
            <svg
              class="size-4"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 10h11M11 5l5 5-5 5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="#projek" class="btn btn-ghost">See all projects</a>
        </div>
        <p class="text-ink-soft mt-7 text-sm font-bold">
          First project: gallery blog —
          <span class="text-ink">React · Express · Neon · Cloudflare R2</span>
        </p>
      </div>
      <PolaroidStack />
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-3">
      {
        features.map((f) => (
          <div class="clay p-6">
            <span class="bg-brand-soft text-brand-deep grid size-11 place-items-center rounded-2xl">
              {f.icon === "bulb" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M9 18h6M10 21h4M12 3a6 6 0 00-3.5 10.9c.5.4.8 1 .9 1.6l.1.5h5l.1-.5c.1-.6.4-1.2.9-1.6A6 6 0 0012 3z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
              {f.icon === "chat" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M21 12a8 8 0 01-8 8H4l2.4-2.4A8 8 0 1121 12z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path d="M9 11h6M9 14h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              )}
              {f.icon === "click" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M9 4v3M4 9h3M6.2 6.2l2 2M15.5 15.5L20 20l-6.5-2.2L12 21l-3-7.5L5 12l7.5-3 3 6.5z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
            </span>
            <h2 class="font-display mt-4 text-lg font-semibold">{f.title}</h2>
            <p class="text-ink-soft mt-2 text-sm leading-relaxed">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Projects -->
  <section id="projek" class="mx-auto mt-20 w-full max-w-6xl scroll-mt-24 px-4 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="font-display text-brand-deep text-xs font-semibold tracking-widest uppercase">
          Projects
        </p>
        <h2 class="font-display mt-2 text-2xl font-semibold sm:text-3xl">
          Every project, one lesson at a time
        </h2>
      </div>
    </div>

    <div class="mt-8 space-y-5">
      {
        availableGroups.map(({ project, published }, i) => {
          const total = published.length + project.upcoming.length;
          return (
            <div class="clay p-6 sm:p-8">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="flex items-start gap-4">
                  <span class="font-display bg-brand-soft text-brand-deep grid size-14 shrink-0 place-items-center rounded-2xl text-xl font-semibold">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <p class="font-display text-2xl font-semibold">
                      {project.title}
                    </p>
                    <p class="text-ink-soft mt-1 max-w-xl text-sm leading-relaxed">
                      {project.tagline}
                    </p>
                    <p class="text-ink-soft/80 mt-2 text-xs font-bold">
                      {project.stack.join(" · ")}
                    </p>
                  </div>
                </div>
                <span class="bg-mint/25 text-mint-deep rounded-full px-3 py-1 text-xs font-bold">
                  {published.length}/{total} lessons done
                </span>
              </div>

              <ol class="mt-6 space-y-2">
                {published.map((lesson) => (
                  <li>
                    <a
                      href={lessonUrl(lesson)}
                      class="group border-line hover:border-brand/50 hover:bg-brand-soft/40 flex items-center gap-3 rounded-2xl border-2 bg-white px-4 py-3 transition-colors"
                    >
                      <span class="font-display bg-brand-soft text-brand-deep grid size-9 shrink-0 place-items-center rounded-xl text-sm font-semibold">
                        {String(lesson.data.order).padStart(2, "0")}
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="font-display block truncate text-sm font-semibold sm:text-base">
                          {lesson.data.title}
                        </span>
                        <span class="text-ink-soft/80 block text-xs font-bold">
                          {lesson.data.duration} · {lesson.data.tags.join(" · ")}
                        </span>
                      </span>
                      <svg
                        class="text-ink-soft group-hover:text-brand size-4 shrink-0 transition-colors"
                        viewBox="0 0 20 20"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M4 10h11M11 5l5 5-5 5"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </li>
                ))}
                {project.upcoming.length > 0 && (
                  <li class="border-line text-ink-soft/70 flex items-center gap-3 rounded-2xl border-2 border-dashed px-4 py-3 text-sm font-bold">
                    <svg
                      class="size-4 shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M6 11V8a6 6 0 1112 0v3M5 11h14v9H5v-9z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {project.upcoming.length} more lessons in the queue —{" "}
                    <a href="#roadmap" class="text-brand underline underline-offset-2">
                      see the roadmap
                    </a>
                  </li>
                )}
              </ol>
            </div>
          );
        })
      }

      <div class="border-line grid place-items-center rounded-3xl border-2 border-dashed bg-white/50 px-6 py-10 text-center">
        <p class="font-display text-lg font-semibold">
          More on the way
        </p>
        <p class="text-ink-soft mt-1 max-w-md text-sm leading-relaxed font-bold">
          This is just the start. New projects and lessons get added as we go —
          finish these two first, don't rush.
        </p>
      </div>
    </div>
  </section>

  <!-- Roadmap -->
  <section id="roadmap" class="mx-auto mt-20 w-full max-w-6xl scroll-mt-24 px-4 sm:px-6">
    <p class="font-display text-brand-deep text-xs font-semibold tracking-widest uppercase">
      Roadmap
    </p>
    <h2 class="font-display mt-2 text-2xl font-semibold sm:text-3xl">
      What's coming up
    </h2>
    <p class="text-ink-soft mt-3 max-w-2xl text-sm leading-relaxed sm:text-base">
      Lessons in the making, in order. We do them one at a time, no skipping.
    </p>

    {
      availableGroups
        .filter(({ project }) => project.upcoming.length > 0)
        .map(({ project }) => (
          <div class="mt-10">
            <p class="font-display text-sm font-semibold">{project.title}</p>
            <ol class="border-line mt-4 space-y-4 border-l-2 border-dashed pl-6 sm:pl-8">
              {project.upcoming.map((item) => (
                <li class="relative">
                  <span class="border-line text-ink-soft font-display absolute -left-[35px] grid size-6 place-items-center rounded-full border-2 bg-white text-[10px] font-semibold sm:-left-[43px]">
                    {item.order}
                  </span>
                  <div class="clay flex flex-col gap-1 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                      <p class="font-display text-base font-semibold">
                        {item.title}
                      </p>
                      <p class="text-ink-soft mt-0.5 text-sm">{item.blurb}</p>
                    </div>
                    <span class="text-ink-soft/70 bg-paper mt-2 shrink-0 rounded-full px-3 py-1 text-xs font-bold sm:mt-0">
                      Coming soon
                    </span>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
    }
  </section>

  <!-- CTA -->
  <section class="mx-auto mt-20 w-full max-w-6xl px-4 sm:px-6">
    <div class="bg-ink relative overflow-hidden rounded-[2rem] px-6 py-12 text-center sm:px-12 sm:py-16">
      <div class="bg-brand/40 absolute -top-24 -left-24 size-64 rounded-full blur-3xl"></div>
      <div class="bg-accent/30 absolute -right-24 -bottom-24 size-64 rounded-full blur-3xl"></div>
      <div class="relative">
        <p class="font-display text-sun text-xs font-semibold tracking-widest uppercase">
          Ready?
        </p>
        <h2 class="font-display mt-3 text-3xl font-semibold text-white sm:text-4xl">
          Let's go. Don't wait to feel "ready".
        </h2>
        <p class="text-brand-soft/90 mx-auto mt-4 max-w-xl text-sm leading-relaxed sm:text-base">
          The first lesson takes about 5 minutes. Finish it, and you'll know
          exactly what we're building.
        </p>
        <a href={firstLessonHref} class="btn btn-primary mt-8">
          Read lesson 1
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
