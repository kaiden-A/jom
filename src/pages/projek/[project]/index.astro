---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { projects, getProject } from "../../../data/projects";
import {
  getPublishedLessons,
  lessonsOf,
  groupLessonsByPart,
  lessonUrl,
} from "../../../utils/lessons";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { project: project.slug },
  }));
}

const { project: slug } = Astro.params;
const project = getProject(slug ?? "");

if (!project) {
  throw new Error(`Unknown project: ${slug}`);
}

const all = await getPublishedLessons();
const published = lessonsOf(all, project.slug);
const groups = groupLessonsByPart(published, project).filter(
  (group) => group.lessons.length > 0 || group.upcoming.length > 0,
);
const total = published.length + project.upcoming.length;
const first = published[0];
const progress = total === 0 ? 0 : Math.round((published.length / total) * 100);
const isFrontend = project.slug === "frontend-development";

const level = isFrontend ? "Beginner" : "Intermediate";
const build = isFrontend
  ? "Calorie calculator"
  : project.slug === "gallery-blog"
    ? "Gallery blog"
    : "Users API";

const builds = [
  {
    number: "01",
    title: "Static",
    body: "HTML structure and CSS styling. It looks real — it just doesn't do anything yet.",
  },
  {
    number: "02",
    title: "JavaScript",
    body: "Wire up the form, calculate totals, and keep the food log in localStorage.",
  },
  {
    number: "03",
    title: "React",
    body: "Rebuild the same app with components and state. Same result, cleaner mental model.",
  },
];
---

<BaseLayout title={`${project.title} · Jom Mula`} description={project.tagline}>
  <section class="border-line bg-brand-soft/60 border-b">
    <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
      <nav class="text-ink-soft text-sm font-bold" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand transition-colors">Home</a>
        <span class="mx-1.5" aria-hidden="true">›</span>
        <a href="/#projek" class="hover:text-brand transition-colors">Projects</a>
        <span class="mx-1.5" aria-hidden="true">›</span>
        <span class="text-ink">{project.title}</span>
      </nav>

      <div class="mt-6 grid grid-cols-1 items-end gap-8 lg:grid-cols-[1.35fr_1fr]">
        <div>
          <p
            class="font-display text-brand-deep text-xs font-semibold tracking-widest uppercase"
          >
            {isFrontend ? "Course" : "Project"} · {project.stack.join(" · ")}
          </p>
          <h1
            class="font-display mt-2 max-w-3xl text-3xl leading-tight font-semibold sm:text-5xl"
          >
            {project.title}
          </h1>
          <p class="text-ink-soft mt-4 max-w-2xl text-lg leading-relaxed">
            {project.tagline}
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-2">
            {
              project.stack.map((item) => (
                <span class="border-line text-ink-soft rounded-full border bg-white px-3 py-1 text-xs font-bold">
                  {item}
                </span>
              ))
            }
            <span class="bg-mint/25 text-mint-deep rounded-full px-3 py-1 text-xs font-bold">
              {published.length}/{total} lessons published
            </span>
          </div>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            {
              first ? (
                <a href={lessonUrl(first)} class="btn btn-primary">
                  Start lesson 1
                  <svg class="size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path
                      d="M4 10h11M11 5l5 5-5 5"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              ) : (
                <span class="btn btn-ghost cursor-not-allowed opacity-60">Coming soon</span>
              )
            }
            <a href="#syllabus" class="btn btn-ghost">See the syllabus</a>
          </div>
        </div>

        <div class="clay p-5 sm:p-6">
          <div class="flex items-center justify-between gap-3">
            <p class="font-display text-sm font-semibold">Course content</p>
            <span class="font-display text-brand-deep text-sm font-semibold">
              {published.length}/{total} published
            </span>
          </div>
          <div class="bg-brand-soft mt-3 h-3 overflow-hidden rounded-full">
            <div class="bg-mint h-full rounded-full" style={`width: ${progress}%`}></div>
          </div>
          <dl class="mt-5 grid grid-cols-2 gap-4 text-sm">
            <div>
              <dt class="text-ink-soft/70 text-[11px] font-bold tracking-widest uppercase">Lessons</dt>
              <dd class="font-display mt-0.5 text-lg font-semibold">{total}</dd>
            </div>
            <div>
              <dt class="text-ink-soft/70 text-[11px] font-bold tracking-widest uppercase">Parts</dt>
              <dd class="font-display mt-0.5 text-lg font-semibold">
                {project.parts?.length ?? 1}
              </dd>
            </div>
            <div>
              <dt class="text-ink-soft/70 text-[11px] font-bold tracking-widest uppercase">Level</dt>
              <dd class="font-display mt-0.5 text-lg font-semibold">{level}</dd>
            </div>
            <div>
              <dt class="text-ink-soft/70 text-[11px] font-bold tracking-widest uppercase">Build</dt>
              <dd class="font-display mt-0.5 text-lg font-semibold">{build}</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  {
    isFrontend && (
      <section class="mx-auto mt-12 w-full max-w-6xl px-4 sm:px-6">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="font-display text-brand-deep text-xs font-semibold tracking-widest uppercase">
              What you'll build
            </p>
            <h2 class="font-display mt-2 text-2xl font-semibold sm:text-3xl">
              One calculator, three versions
            </h2>
          </div>
        </div>
        <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
          {builds.map((item) => (
            <div class="clay p-5">
              <span class="font-display bg-brand-soft text-brand-deep grid size-10 place-items-center rounded-2xl text-sm font-semibold">
                {item.number}
              </span>
              <p class="font-display mt-4 text-lg font-semibold">{item.title}</p>
              <p class="text-ink-soft mt-1 text-sm leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <div
    class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-8 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,1fr)_300px]"
  >
    <div id="syllabus" class="scroll-mt-24">
      <p
        class="font-display text-brand-deep text-xs font-semibold tracking-widest uppercase"
      >
        Syllabus
      </p>
      <h2 class="font-display mt-2 text-2xl font-semibold sm:text-3xl">
        Every lesson, in order
      </h2>
      <p class="text-ink-soft mt-3 max-w-2xl text-sm leading-relaxed sm:text-base">
        Each lesson is short and builds on the one before it. No skipping — the
        next lesson assumes you finished the last one.
      </p>

      <div class="mt-6 space-y-5">
        {
          groups.map(({ part, lessons, upcoming }, index) => (
            <section class="clay p-5 sm:p-6">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-display text-brand-deep text-[11px] font-semibold tracking-widest uppercase">
                    {project.parts ? `Part ${index + 1}` : "Syllabus"}
                  </p>
                  <h3 class="font-display mt-1 text-xl font-semibold">
                    {project.parts ? part.title : "All lessons"}
                  </h3>
                  <p class="text-ink-soft mt-1 max-w-xl text-sm leading-relaxed">
                    {project.parts
                      ? part.blurb
                      : "Every lesson, in the order it was written."}
                  </p>
                </div>
                <span class="bg-brand-soft text-brand-deep rounded-full px-3 py-1 text-xs font-bold">
                  {lessons.length}/{lessons.length + upcoming.length}
                </span>
              </div>

              <ol class="mt-5 space-y-2">
                {lessons.map((lesson) => (
                  <li>
                    <a
                      href={lessonUrl(lesson)}
                      class="group border-line hover:border-brand/50 hover:bg-brand-soft/40 flex items-center gap-3 rounded-2xl border-2 bg-white px-4 py-3 transition-colors"
                    >
                      <span class="font-display bg-brand-soft text-brand-deep grid size-9 shrink-0 place-items-center rounded-xl text-sm font-semibold">
                        {String(lesson.data.order).padStart(2, "0")}
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="font-display block truncate text-sm font-semibold sm:text-base">
                          {lesson.data.title}
                        </span>
                        <span class="text-ink-soft/80 block text-xs font-bold">
                          {lesson.data.duration} · {lesson.data.tags.join(" · ")}
                        </span>
                      </span>
                      <svg
                        class="text-ink-soft group-hover:text-brand size-4 shrink-0 transition-colors"
                        viewBox="0 0 20 20"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M4 10h11M11 5l5 5-5 5"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </li>
                ))}
                {upcoming.map((item) => (
                  <li class="border-line text-ink-soft/60 flex items-center gap-3 rounded-2xl border-2 border-dashed px-4 py-3">
                    <span class="font-display bg-paper text-ink-soft/70 grid size-9 shrink-0 place-items-center rounded-xl text-sm font-semibold">
                      {String(item.order).padStart(2, "0")}
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="font-display block text-sm font-semibold">
                        {item.title}
                      </span>
                      <span class="block text-xs font-bold">{item.blurb}</span>
                    </span>
                    <span class="bg-paper shrink-0 rounded-full px-2.5 py-1 text-[10px] font-bold uppercase">
                      Soon
                    </span>
                  </li>
                ))}
              </ol>
            </section>
          ))
        }
      </div>
    </div>

    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
      <div class="clay p-5">
        <p class="font-display text-sm font-semibold">What you need</p>
        <ul class="text-ink-soft mt-3 space-y-2 text-sm leading-relaxed">
          <li>• A browser — Chrome, Firefox, Edge, anything modern.</li>
          <li>• A code editor. VS Code is the easy default.</li>
          {isFrontend && <li>• Node.js only when you reach the React part.</li>}
          <li>• Patience. The lessons are short; the practice is the work.</li>
        </ul>
      </div>

      <div class="note rounded-2xl p-5">
        <p class="font-display text-sm font-semibold">How to follow</p>
        <p class="text-ink-soft mt-1 text-sm leading-relaxed">
          Read in order. Type the code yourself. Don't copy-paste — the typing
          is where the learning happens.
        </p>
      </div>

      {first && (
        <a href={lessonUrl(first)} class="btn btn-primary w-full">
          Start lesson 1
        </a>
      )}
    </aside>
  </div>
</BaseLayout>
