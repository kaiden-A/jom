---
interface Message {
  role: "user" | "ai";
  tag?: string;
  text: string;
}

const messages: Message[] = [
  {
    role: "user",
    tag: "Prompt 1",
    text: "Build a gallery blog mockup with HTML + Tailwind + Font Awesome + JavaScript. In a single index.html file. Include a photo grid, folder filter, and lightbox. Cream background #FAF7F2 with indigo accent #4F46E5. Clean design, plenty of whitespace.",
  },
  {
    role: "ai",
    text: "Done — index.html has the photo grid, folder filter and lightbox. Open it in the browser and try clicking around.",
  },
  {
    role: "user",
    tag: "Follow-up",
    text: "Almost there, but the background is too bright and the grid feels cramped. Change the background to #F5F1E8, add more spacing between the cards. Keep everything else.",
  },
  {
    role: "ai",
    text: "Done — background changed, spacing is roomier now. Everything else stays the same.",
  },
  {
    role: "user",
    tag: "Follow-up",
    text: "Nice. Now add an 'Admin' button at the top right — when clicked, an upload form appears. Mockup only.",
  },
  {
    role: "ai",
    text: "Done. Hit Admin for the upload form, hit Visitor to go back to the gallery.",
  },
];
---

<div class="not-prose my-8">
  <div class="clay overflow-hidden">
    <div
      class="border-line bg-paper/70 flex flex-wrap items-center justify-between gap-2 border-b px-4 py-3 sm:px-5"
    >
      <p class="font-display text-sm font-semibold">A sample iterate session</p>
      <span class="text-ink-soft text-xs font-bold">
        the first prompt is rarely perfect — and that's normal
      </span>
    </div>

    <div class="space-y-5 p-4 sm:p-6">
      {
        messages.map((message) =>
          message.role === "user" ? (
            <div class="flex flex-col items-end gap-1.5">
              {message.tag && (
                <span class="bg-brand-soft text-brand-deep rounded-full px-2.5 py-0.5 text-[10px] font-bold tracking-wide uppercase">
                  {message.tag}
                </span>
              )}
              <div class="bg-brand max-w-[85%] rounded-2xl rounded-br-md px-4 py-3 text-sm leading-relaxed font-bold text-white">
                {message.text}
              </div>
            </div>
          ) : (
            <div class="flex items-start gap-2.5">
              <span class="bg-ink text-sun font-display grid size-8 shrink-0 place-items-center rounded-full text-[10px] font-semibold">
                oc
              </span>
              <div class="max-w-[85%]">
                <p class="text-ink-soft/70 mb-1 text-[10px] font-bold tracking-wide uppercase">
                  opencode
                </p>
                <div class="border-line text-ink-soft rounded-2xl rounded-bl-md border-2 bg-white px-4 py-3 text-sm leading-relaxed font-bold">
                  {message.text}
                </div>
              </div>
            </div>
          ),
        )
      }
    </div>
  </div>
</div>
