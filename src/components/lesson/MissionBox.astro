---
interface Props {
  title?: string;
  body: string;
  code?: string;
  note?: string;
}

const { title = "Your mission", body, code, note } = Astro.props;
---

<div
  class="not-prose border-mint-deep/40 bg-mint/10 my-8 rounded-2xl border-2 border-dashed p-5 sm:p-6"
>
  <div class="flex items-start gap-3.5">
    <span
      class="bg-mint-deep grid size-10 shrink-0 place-items-center rounded-xl text-white"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.9"></circle>
        <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.9"></circle>
        <circle cx="12" cy="12" r="1.4" fill="currentColor"></circle>
      </svg>
    </span>
    <div class="min-w-0 flex-1 pt-0.5">
      <div class="flex flex-wrap items-center gap-2">
        <p class="font-display text-sm font-semibold">{title}</p>
        <span
          class="border-mint-deep/40 text-mint-deep rounded-full border bg-white px-2 py-0.5 text-[10px] font-bold tracking-wide uppercase"
        >
          the plan's verify step
        </span>
      </div>
      <p class="text-ink-soft mt-1.5 text-sm leading-relaxed sm:text-[15px]">
        {body}
      </p>
      {code && (
        <pre
          class="mt-3 overflow-x-auto rounded-xl bg-[#1e1938] px-4 py-3 font-mono text-xs leading-relaxed text-[#e9e6f7]"
        ><code>{code}</code></pre>
      )}
      {note && (
        <p class="text-ink-soft/70 mt-2.5 text-xs font-bold">{note}</p>
      )}
    </div>
  </div>
</div>
