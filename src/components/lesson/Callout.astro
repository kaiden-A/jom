---
interface Props {
  variant?: "note" | "haa" | "tip" | "warn";
  title?: string;
}

const { variant = "note", title } = Astro.props;

const config = {
  note: {
    box: "bg-brand-soft/80 border-brand",
    chip: "bg-brand text-white",
    defaultTitle: "Note",
    icon: "M12 3a6 6 0 00-3.5 10.9c.5.4.8 1 .9 1.6l.1.5h5l.1-.5c.1-.6.4-1.2.9-1.6A6 6 0 0012 3zM10 21h4",
  },
  haa: {
    box: "border-sun",
    chip: "bg-ink text-sun",
    defaultTitle: "Haa!",
    icon: "M13 2L4.5 13.5H11L9.5 22 19 10h-6.5L13 2z",
  },
  tip: {
    box: "bg-mint/15 border-mint-deep",
    chip: "bg-mint-deep text-white",
    defaultTitle: "Tip",
    icon: "M20 6L9 17l-5-5",
  },
  warn: {
    box: "bg-accent/10 border-accent",
    chip: "bg-accent text-ink",
    defaultTitle: "Careful",
    icon: "M12 3l9 16H3l9-16zM12 9v5M12 17.5v.5",
  },
} as const;

const c = config[variant];
const heading = title ?? c.defaultTitle;
---

<aside
  class:list={[
    "not-prose my-8 rounded-2xl border-l-4 p-4 sm:p-5",
    c.box,
    variant === "haa" && "note",
  ]}
>
  <div class="flex gap-3.5">
    <span
      class:list={[
        "grid size-9 shrink-0 place-items-center rounded-xl",
        c.chip,
      ]}
    >
      <svg class="size-4.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d={c.icon}
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
    <div class="callout-body min-w-0 pt-0.5">
      <p class="font-display text-sm font-semibold">{heading}</p>
      <div class="text-ink-soft mt-1 text-sm leading-relaxed sm:text-[15px]">
        <slot />
      </div>
    </div>
  </div>
</aside>

<style>
  .callout-body :global(p) {
    margin: 0;
  }
  .callout-body :global(p + p) {
    margin-top: 0.5rem;
  }
  .callout-body :global(strong) {
    color: var(--color-ink);
    font-weight: 800;
  }
</style>
