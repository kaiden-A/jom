---
interface Props {
  number: number;
  title: string;
  blurb: string;
  href?: string;
}

const { number, title, blurb, href } = Astro.props;
const label = String(number).padStart(2, "0");
---

<div
  class="not-prose border-line my-8 rounded-3xl border-2 border-dashed bg-white/70 p-6 sm:p-8"
>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <span
        class="bg-ink text-sun font-display grid size-14 shrink-0 place-items-center rounded-2xl text-xl font-semibold"
      >
        {label}
      </span>
      <div>
        <p
          class="font-display text-brand-deep text-xs font-semibold tracking-widest uppercase"
        >
          Up next
        </p>
        <p class="font-display text-lg font-semibold sm:text-xl">{title}</p>
        <p class="text-ink-soft mt-1 text-sm font-bold">{blurb}</p>
      </div>
    </div>
    {
      href ? (
        <a
          href={href}
          class="btn btn-primary !min-h-10 !px-4 !py-1.5 text-sm"
        >
          Read now
          <svg class="size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M4 10h11M11 5l5 5-5 5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      ) : (
        <div class="flex items-center gap-3">
          <span class="text-ink-soft bg-paper inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-bold">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M6 11V8a6 6 0 1112 0v3M5 11h14v9H5v-9z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            Coming soon
          </span>
          <a href="/#roadmap" class="btn btn-ghost !min-h-10 !px-4 !py-1.5 text-sm">
            View roadmap
          </a>
        </div>
      )
    }
  </div>
</div>
