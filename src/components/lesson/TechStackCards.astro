---
export interface StackItem {
  name: string;
  role: string;
  monogram: string;
  tone: string;
  desc: string;
  why: string;
}

interface Props {
  items?: StackItem[];
}

const defaultStack: StackItem[] = [
  {
    name: "React",
    role: "Frontend",
    monogram: "Re",
    tone: "bg-[#61dafb] text-ink",
    desc: "Everything people see — the photo grid, the lightbox, the admin dashboard. This is what you write with JavaScript.",
    why: "Easy to split the UI into components, and you can reuse them for both the public side and the admin side.",
  },
  {
    name: "ExpressJS",
    role: "Backend API",
    monogram: "Ex",
    tone: "bg-ink text-white",
    desc: "The doorway for data. React asks, Express answers. Uploads, comments, likes — all go through here.",
    why: "Lightweight with very little magic. You can see what every line does.",
  },
  {
    name: "Neon",
    role: "Database (Postgres)",
    monogram: "Ne",
    tone: "bg-[#00e599] text-ink",
    desc: "Stores the structured data: photo list, folders, comments, likes, and the admin user.",
    why: "Serverless Postgres — no need to set up your own database server, and it has a free tier.",
  },
  {
    name: "Cloudflare R2",
    role: "Photo storage",
    monogram: "R2",
    tone: "bg-[#f38020] text-ink",
    desc: "Stores the photo files themselves. The database only keeps the URL, not the file.",
    why: "Cheap (no egress fees), fast, and S3-compatible — easy to work with.",
  },
];

const { items = defaultStack } = Astro.props;
---

<div class="not-prose my-8 grid gap-5 sm:grid-cols-2">
  {
    items.map((item) => (
      <div class="clay flex flex-col p-5">
        <div class="flex items-center gap-3">
          <span
            class:list={[
              "font-display grid size-11 place-items-center rounded-2xl text-sm font-semibold",
              item.tone,
            ]}
          >
            {item.monogram}
          </span>
          <div>
            <p class="font-display text-lg leading-tight font-semibold">
              {item.name}
            </p>
            <p class="text-ink-soft text-xs font-bold">{item.role}</p>
          </div>
        </div>
        <p class="text-ink-soft mt-4 text-sm leading-relaxed">{item.desc}</p>
        <div class="bg-brand-soft/70 mt-4 rounded-xl p-3">
          <p class="text-brand-deep flex items-center gap-1.5 text-xs font-bold uppercase">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 3a6 6 0 00-3.5 10.9c.5.4.8 1 .9 1.6l.1.5h5l.1-.5c.1-.6.4-1.2.9-1.6A6 6 0 0012 3zM10 21h4"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            Why this?
          </p>
          <p class="text-ink-soft mt-1 text-sm leading-relaxed">{item.why}</p>
        </div>
      </div>
    ))
  }
</div>
