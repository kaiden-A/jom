---
export interface TreePart {
  text: string;
  type: "root" | "folder" | "file";
  comment?: string;
}

export interface TreeTag {
  code: string;
  label: string;
}

interface Props {
  title?: string;
  tree?: TreePart[][];
  tags?: TreeTag[];
}

const defaultTree: TreePart[][] = [
  [{ text: "gallery-blog/", type: "root", comment: "" }],
  [
    { text: "├─ apps/", type: "folder", comment: "every app in one place" },
  ],
  [
    { text: "│  ├─ web/", type: "folder", comment: "React — public site + admin UI" },
  ],
  [{ text: "│  │  ├─ src/", type: "folder", comment: "" }],
  [{ text: "│  │  └─ package.json", type: "file", comment: "dependencies for web" }],
  [{ text: "│  └─ api/", type: "folder", comment: "Express — REST API" }],
  [{ text: "│     ├─ src/", type: "folder", comment: "" }],
  [{ text: "│     └─ package.json", type: "file", comment: "dependencies for api" }],
  [
    { text: "├─ packages/", type: "folder", comment: "things we share" },
  ],
  [{ text: "│  └─ shared/", type: "folder", comment: "shared types & helpers" }],
  [
    { text: "├─ package.json", type: "file", comment: "scripts for every app" },
  ],
  [{ text: "└─ README.md", type: "file", comment: "how to run the project" }],
];

const defaultTags: TreeTag[] = [
  { code: "apps/web", label: "= React" },
  { code: "apps/api", label: "= Express" },
  { code: "packages/shared", label: "= shared" },
];

const {
  title = "Repo structure",
  tree = defaultTree,
  tags = defaultTags,
} = Astro.props;
---

<div class="not-prose my-8">
  <div class="clay overflow-x-auto p-5">
    <p class="text-ink-soft mb-3 text-xs font-bold tracking-widest uppercase">
      {title}
    </p>
    <pre class="font-mono text-[12.5px] leading-7"><code>{tree.map((line) => (
        <span class="block whitespace-nowrap">{line.map((part) => (
          <>
            <span
              class:list={[
                part.type === "folder" && "text-brand font-bold",
                part.type === "file" && "text-ink",
                part.type === "root" && "text-ink font-bold",
              ]}
            >
              {part.text}
            </span>
            {part.comment && (
              <span class="text-ink-soft/70"> {part.comment}</span>
            )}
          </>
        ))}</span>
      ))}</code></pre>
  </div>
  <div class="mt-3 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="border-line rounded-full border bg-white px-3 py-1 text-xs font-bold">
        <span class="text-brand font-mono">{tag.code}</span> {tag.label}
      </span>
    ))}
  </div>
</div>
