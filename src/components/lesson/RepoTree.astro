---
export interface TreePart {
  text: string;
  type: "root" | "folder" | "file";
  comment?: string;
}

export interface TreeTag {
  code: string;
  label: string;
}

interface Props {
  title?: string;
  tree?: TreePart[][];
  tags?: TreeTag[];
}

const defaultTree: TreePart[][] = [
  [{ text: "gallery-blog/", type: "root", comment: "" }],
  [{ text: "├─ src/", type: "folder", comment: "the server — one app" }],
  [{ text: "│  ├─ app.ts", type: "file", comment: "middleware order + routers" }],
  [{ text: "│  ├─ index.ts", type: "file", comment: "boot: settings, db, listen" }],
  [{ text: "│  ├─ config.ts", type: "file", comment: "zod-parsed env → Settings" }],
  [{ text: "│  ├─ db/", type: "folder", comment: "schema + client" }],
  [{ text: "│  ├─ services/", type: "folder", comment: "the business logic" }],
  [{ text: "│  ├─ middleware/", type: "folder", comment: "auth, same-origin, headers" }],
  [{ text: "│  └─ routes/", type: "folder", comment: "URLs in, responses out" }],
  [{ text: "├─ views/", type: "folder", comment: "EJS templates" }],
  [{ text: "│  ├─ partials/", type: "folder", comment: "head + foot on every page" }],
  [{ text: "│  └─ photos.ejs", type: "file", comment: "list + create form" }],
  [{ text: "├─ public/", type: "folder", comment: "served as-is" }],
  [{ text: "│  ├─ css/app.css", type: "file", comment: "hand-written, small" }],
  [{ text: "│  └─ js/", type: "folder", comment: "app.js + upload.js" }],
  [{ text: "├─ drizzle/", type: "folder", comment: "generated SQL migrations" }],
  [{ text: "├─ test/", type: "folder", comment: "vitest on a test branch" }],
  [{ text: "├─ master-plan.md", type: "file", comment: "the document we follow" }],
  [{ text: "└─ package.json", type: "file", comment: "scripts: dev, test, db:migrate" }],
];

const defaultTags: TreeTag[] = [
  { code: "src/", label: "= the server" },
  { code: "views/", label: "= the pages" },
  { code: "public/", label: "= browser files" },
  { code: "drizzle/", label: "= migrations" },
];

const {
  title = "Repo structure",
  tree = defaultTree,
  tags = defaultTags,
} = Astro.props;
---

<div class="not-prose my-8">
  <div class="clay overflow-x-auto p-5">
    <p class="text-ink-soft mb-3 text-xs font-bold tracking-widest uppercase">
      {title}
    </p>
    <pre class="font-mono text-[12.5px] leading-7"><code>{tree.map((line) => (
        <span class="block whitespace-nowrap">{line.map((part) => (
          <>
            <span
              class:list={[
                part.type === "folder" && "text-brand font-bold",
                part.type === "file" && "text-ink",
                part.type === "root" && "text-ink font-bold",
              ]}
            >
              {part.text}
            </span>
            {part.comment && (
              <span class="text-ink-soft/70"> {part.comment}</span>
            )}
          </>
        ))}</span>
      ))}</code></pre>
  </div>
  <div class="mt-3 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="border-line rounded-full border bg-white px-3 py-1 text-xs font-bold">
        <span class="text-brand font-mono">{tag.code}</span> {tag.label}
      </span>
    ))}
  </div>
</div>
