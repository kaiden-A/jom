---
import { getCollection } from "astro:content";
import { roadmap } from "../../data/roadmap";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const lessons = (await getCollection("lessons", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.lesson - b.data.lesson,
);
const current = lessons.find((l) => l.data.slug === currentSlug);
const doneCount = current ? lessons.filter((l) => l.data.lesson < current.data.lesson).length + 1 : 0;
const totalCount = lessons.length + roadmap.length;
---

<div class="space-y-5 lg:sticky lg:top-24">
  <details class="clay group px-4 py-3 lg:hidden">
    <summary
      class="font-display flex cursor-pointer items-center justify-between text-sm font-semibold"
    >
      <span>Dalam siri ni ({doneCount}/{totalCount})</span>
      <svg
        class="text-ink-soft size-4 transition-transform group-open:rotate-180"
        viewBox="0 0 20 20"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M5 8l5 5 5-5"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </summary>
    <ol class="mt-3 space-y-1">
      {
        lessons.map((l) => (
          <li>
            <a
              href={`/lessons/${l.data.slug}`}
              class:list={[
                "flex items-start gap-2.5 rounded-xl px-2.5 py-2 text-sm font-bold transition-colors",
                l.data.slug === currentSlug
                  ? "bg-brand-soft text-brand-deep"
                  : "text-ink-soft hover:text-ink",
              ]}
            >
              <span class="font-display">
                {String(l.data.lesson).padStart(2, "0")}
              </span>
              <span>{l.data.title}</span>
            </a>
          </li>
        ))
      }
      {
        roadmap.map((r) => (
          <li class="flex items-start gap-2.5 px-2.5 py-2 text-sm font-bold opacity-50">
            <span class="font-display">{String(r.n).padStart(2, "0")}</span>
            <span>{r.title}</span>
          </li>
        ))
      }
    </ol>
  </details>

  <nav class="clay hidden p-3 lg:block" aria-label="Senarai lesson">
    <p
      class="font-display text-ink-soft px-2.5 pt-2 text-xs font-semibold tracking-widest uppercase"
    >
      Dalam siri ni
    </p>
    <ol class="mt-2 space-y-1">
      {
        lessons.map((l) => (
          <li>
            <a
              href={`/lessons/${l.data.slug}`}
              aria-current={l.data.slug === currentSlug ? "page" : undefined}
              class:list={[
                "flex items-start gap-2.5 rounded-xl px-2.5 py-2 text-sm font-bold transition-colors",
                l.data.slug === currentSlug
                  ? "bg-brand-soft text-brand-deep"
                  : "text-ink-soft hover:bg-brand-soft/50 hover:text-ink",
              ]}
            >
              <span class="font-display">
                {String(l.data.lesson).padStart(2, "0")}
              </span>
              <span>{l.data.title}</span>
            </a>
          </li>
        ))
      }
      {
        roadmap.map((r) => (
          <li class="text-ink-soft/60 flex items-start gap-2.5 px-2.5 py-2 text-sm font-bold">
            <span class="font-display">{String(r.n).padStart(2, "0")}</span>
            <span class="flex-1">{r.title}</span>
            <svg
              class="mt-0.5 size-3.5 shrink-0"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <rect
                x="4"
                y="9"
                width="12"
                height="8"
                rx="2"
                stroke="currentColor"
                stroke-width="1.6"
              />
              <path
                d="M7 9V7a3 3 0 016 0v2"
                stroke="currentColor"
                stroke-width="1.6"
              />
            </svg>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="note rounded-2xl p-4">
    <p class="font-display text-sm font-semibold">Baca ikut turutan</p>
    <p class="text-ink-soft mt-1 text-sm leading-relaxed">
      Setiap lesson pendek je. Habiskan satu, baru pergi yang seterusnya —
      jangan skip.
    </p>
  </div>
</div>
