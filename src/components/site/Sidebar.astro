---
import LessonMenu from "./LessonMenu.astro";
import { projects } from "../../data/projects";
import { getPublishedLessons, lessonsOf } from "../../utils/lessons";

interface Props {
  currentProject: string;
  currentSlug: string;
}

const { currentProject, currentSlug } = Astro.props;
const all = await getPublishedLessons();
const activeProject = projects.find((project) => project.slug === currentProject);
const activeLessons = lessonsOf(all, currentProject);
const total =
  activeLessons.length + (activeProject?.upcoming.length ?? 0);
const current = activeLessons.find((lesson) => lesson.data.slug === currentSlug);
const currentNumber = String(current?.data.order ?? 1).padStart(2, "0");
const totalLabel = String(total).padStart(2, "0");
---

<div class="space-y-5 lg:sticky lg:top-24">
  <details class="clay group px-4 py-3 lg:hidden">
    <summary
      class="font-display flex cursor-pointer list-none items-center justify-between text-sm font-semibold [&::-webkit-details-marker]:hidden"
    >
      <span>In this project ({currentNumber}/{totalLabel})</span>
      <svg
        class="text-ink-soft size-4 transition-transform group-open:rotate-180"
        viewBox="0 0 20 20"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M5 8l5 5 5-5"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </summary>
    <div class="mt-3">
      <LessonMenu currentProject={currentProject} currentSlug={currentSlug} />
    </div>
  </details>

  <nav class="clay hidden p-3 lg:block" aria-label="Lesson list">
    <p
      class="font-display text-ink-soft px-2.5 pt-2 text-xs font-semibold tracking-widest uppercase"
    >
      Lessons
    </p>
    <div class="mt-2">
      <LessonMenu currentProject={currentProject} currentSlug={currentSlug} />
    </div>
  </nav>

  <div class="note rounded-2xl p-4">
    <p class="font-display text-sm font-semibold">Read in order</p>
    <p class="text-ink-soft mt-1 text-sm leading-relaxed">
      Each lesson is short. Finish one, then move on to the next — don't skip.
    </p>
  </div>
</div>
