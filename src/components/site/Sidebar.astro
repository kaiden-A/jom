---
import { projects } from "../../data/projects";
import { getPublishedLessons, lessonsOf, projectUrl } from "../../utils/lessons";

interface Props {
  currentProject: string;
  currentSlug: string;
}

const { currentProject, currentSlug } = Astro.props;
const all = await getPublishedLessons();

const groups = projects.map((project) => ({
  project,
  published: lessonsOf(all, project.slug),
}));

const activeGroup = groups.find((g) => g.project.slug === currentProject);
const current = activeGroup?.published.find((l) => l.data.slug === currentSlug);
const total =
  (activeGroup?.published.length ?? 0) +
  (activeGroup?.project.upcoming.length ?? 0);
const currentNumber = String(current?.data.order ?? 1).padStart(2, "0");
const totalLabel = String(total).padStart(2, "0");
---

<div class="space-y-5 lg:sticky lg:top-24">
  <details class="clay group px-4 py-3 lg:hidden">
    <summary
      class="font-display flex cursor-pointer items-center justify-between text-sm font-semibold"
    >
      <span>Dalam projek ni ({currentNumber}/{totalLabel})</span>
      <svg
        class="text-ink-soft size-4 transition-transform group-open:rotate-180"
        viewBox="0 0 20 20"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M5 8l5 5 5-5"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </summary>
    <ol class="mt-3 space-y-1">
      {
        groups.map((group) => (
          <>
            <li class="text-ink-soft/70 px-2.5 pt-3 pb-1 text-[11px] font-bold tracking-widest uppercase">
              {group.project.title}
            </li>
            {group.published.map((l) => (
              <li>
                <a
                  href={projectUrl(group.project.slug, l.data.slug)}
                  class:list={[
                    "flex items-start gap-2.5 rounded-xl px-2.5 py-2 text-sm font-bold transition-colors",
                    l.data.slug === currentSlug && l.data.project === currentProject
                      ? "bg-brand-soft text-brand-deep"
                      : "text-ink-soft hover:text-ink",
                  ]}
                >
                  <span class="font-display">
                    {String(l.data.order).padStart(2, "0")}
                  </span>
                  <span>{l.data.title}</span>
                </a>
              </li>
            ))}
            {group.project.upcoming.map((r) => (
              <li class="flex items-start gap-2.5 px-2.5 py-2 text-sm font-bold opacity-50">
                <span class="font-display">{String(r.order).padStart(2, "0")}</span>
                <span>{r.title}</span>
              </li>
            ))}
          </>
        ))
      }
    </ol>
  </details>

  <nav class="clay hidden p-3 lg:block" aria-label="Senarai sub-lesson">
    <p
      class="font-display text-ink-soft px-2.5 pt-2 text-xs font-semibold tracking-widest uppercase"
    >
      Dalam projek ni
    </p>
    {
      groups.map((group) => (
        <div class="mt-2">
          <p class="text-ink-soft/70 flex items-center justify-between px-2.5 py-1 text-[11px] font-bold tracking-widest uppercase">
            <span>{group.project.title}</span>
            <span class="font-display">
              {String(group.published.length + group.project.upcoming.length).padStart(2, "0")}{" "}
              sub-lesson
            </span>
          </p>
          <ol class="space-y-1">
            {group.published.map((l) => (
              <li>
                <a
                  href={projectUrl(group.project.slug, l.data.slug)}
                  aria-current={
                    l.data.slug === currentSlug && l.data.project === currentProject
                      ? "page"
                      : undefined
                  }
                  class:list={[
                    "flex items-start gap-2.5 rounded-xl px-2.5 py-2 text-sm font-bold transition-colors",
                    l.data.slug === currentSlug && l.data.project === currentProject
                      ? "bg-brand-soft text-brand-deep"
                      : "text-ink-soft hover:bg-brand-soft/50 hover:text-ink",
                  ]}
                >
                  <span class="font-display">
                    {String(l.data.order).padStart(2, "0")}
                  </span>
                  <span>{l.data.title}</span>
                </a>
              </li>
            ))}
            {group.project.upcoming.map((r) => (
              <li class="text-ink-soft/60 flex items-start gap-2.5 px-2.5 py-2 text-sm font-bold">
                <span class="font-display">{String(r.order).padStart(2, "0")}</span>
                <span class="flex-1">{r.title}</span>
                <svg
                  class="mt-0.5 size-3.5 shrink-0"
                  viewBox="0 0 20 20"
                  fill="none"
                  aria-hidden="true"
                >
                  <rect
                    x="4"
                    y="9"
                    width="12"
                    height="8"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="1.6"
                  />
                  <path
                    d="M7 9V7a3 3 0 016 0v2"
                    stroke="currentColor"
                    stroke-width="1.6"
                  />
                </svg>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </nav>

  <div class="note rounded-2xl p-4">
    <p class="font-display text-sm font-semibold">Baca ikut turutan</p>
    <p class="text-ink-soft mt-1 text-sm leading-relaxed">
      Setiap sub-lesson pendek je. Habiskan satu, baru pergi yang seterusnya —
      jangan skip.
    </p>
  </div>
</div>
