---
---

<div class="relative h-[320px] w-full sm:h-[420px]" aria-hidden="true">
  <div class="absolute top-14 left-0 w-28 sm:top-16 sm:w-48">
    <div class="float-soft" style="--tilt: -7deg; animation-delay: 0.5s">
      <figure
        class="shadow-clay relative -rotate-0 rounded-2xl bg-white p-2 pb-7 sm:p-2.5 sm:pb-9"
      >
        <div class="overflow-hidden rounded-xl">
          <svg viewBox="0 0 200 150" class="h-auto w-full">
            <defs>
              <linearGradient id="polSkyA" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#c7d2fe"></stop>
                <stop offset="1" stop-color="#fbcfe8"></stop>
              </linearGradient>
              <linearGradient id="polMtA" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#34d399"></stop>
                <stop offset="1" stop-color="#059669"></stop>
              </linearGradient>
            </defs>
            <rect width="200" height="150" fill="url(#polSkyA)"></rect>
            <circle cx="148" cy="38" r="18" fill="#facc15"></circle>
            <path d="M0 110 L55 45 L95 110 Z" fill="#a7f3d0"></path>
            <path d="M40 110 L105 30 L170 110 Z" fill="url(#polMtA)"></path>
            <path d="M125 110 L165 62 L200 110 Z" fill="#6ee7b7"></path>
            <rect y="110" width="200" height="40" fill="#fef3c7"></rect>
          </svg>
        </div>
        <figcaption
          class="font-display text-ink-soft absolute bottom-1.5 left-0 w-full text-center text-[10px] font-medium sm:bottom-2.5 sm:text-xs"
        >
          morning at the mountain
        </figcaption>
      </figure>
    </div>
  </div>

  <div class="absolute top-0 left-1/2 z-10 w-32 -translate-x-1/2 sm:w-52">
    <div class="float-soft" style="--tilt: 2deg">
      <figure
        class="shadow-clay relative rounded-2xl bg-white p-2 pb-7 sm:p-2.5 sm:pb-9"
      >
        <span
          class="bg-sun/70 absolute -top-2 left-1/2 h-5 w-12 -translate-x-1/2 -rotate-3 rounded-sm sm:w-16"
        ></span>
        <div class="overflow-hidden rounded-xl">
          <svg viewBox="0 0 200 150" class="h-auto w-full">
            <defs>
              <linearGradient id="polCatBg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#e0e7ff"></stop>
                <stop offset="1" stop-color="#f5d0fe"></stop>
              </linearGradient>
            </defs>
            <rect width="200" height="150" fill="url(#polCatBg)"></rect>
            <path d="M68 55 L86 28 L98 58 Z" fill="#fdba74"></path>
            <path d="M132 55 L114 28 L102 58 Z" fill="#fdba74"></path>
            <path d="M76 50 L86 36 L93 53 Z" fill="#fca5a5"></path>
            <path d="M124 50 L114 36 L107 53 Z" fill="#fca5a5"></path>
            <circle cx="100" cy="85" r="42" fill="#fdba74"></circle>
            <circle cx="85" cy="78" r="5" fill="#221c46"></circle>
            <circle cx="115" cy="78" r="5" fill="#221c46"></circle>
            <circle cx="86.5" cy="76.5" r="1.6" fill="#ffffff"></circle>
            <circle cx="116.5" cy="76.5" r="1.6" fill="#ffffff"></circle>
            <path d="M96 92 L104 92 L100 98 Z" fill="#fb7185"></path>
            <path
              d="M100 98 q-5 6 -10 2 M100 98 q5 6 10 2"
              stroke="#221c46"
              stroke-width="2"
              fill="none"
              stroke-linecap="round"></path>
            <path
              d="M60 85 h-18 M60 92 l-17 5 M140 85 h18 M140 92 l17 5"
              stroke="#221c46"
              stroke-width="1.6"
              opacity="0.45"
              stroke-linecap="round"></path>
            <circle cx="72" cy="92" r="5" fill="#fca5a5" opacity="0.5"></circle>
            <circle cx="128" cy="92" r="5" fill="#fca5a5" opacity="0.5"
            ></circle>
          </svg>
        </div>
        <figcaption
          class="font-display text-ink-soft absolute bottom-1.5 left-0 w-full text-center text-[10px] font-medium sm:bottom-2.5 sm:text-xs"
        >
          the neighbour's cat
        </figcaption>
        <span
          class="bg-accent text-ink font-display shadow-clay-xs absolute -top-3 -right-3 rotate-6 rounded-full px-2 py-0.5 text-[10px] font-semibold sm:px-2.5 sm:py-1 sm:text-xs"
        >
          Jom!
        </span>
      </figure>
    </div>
  </div>

  <div class="absolute right-0 bottom-2 w-28 sm:bottom-6 sm:w-48">
    <div class="float-soft" style="--tilt: 8deg; animation-delay: 1s">
      <figure
        class="shadow-clay relative rounded-2xl bg-white p-2 pb-7 sm:p-2.5 sm:pb-9"
      >
        <div class="overflow-hidden rounded-xl">
          <svg viewBox="0 0 200 150" class="h-auto w-full">
            <defs>
              <linearGradient id="polCofBg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#fef3c7"></stop>
                <stop offset="1" stop-color="#fed7aa"></stop>
              </linearGradient>
            </defs>
            <rect width="200" height="150" fill="url(#polCofBg)"></rect>
            <path
              d="M84 34 q-6 10 0 18 q6 8 0 16 M104 28 q-6 10 0 18 q6 8 0 16 M124 34 q-6 10 0 18 q6 8 0 16"
              stroke="#d6d3d1"
              stroke-width="3"
              fill="none"
              stroke-linecap="round"></path>
            <ellipse cx="100" cy="126" rx="52" ry="9" fill="#e7e5e4"></ellipse>
            <path
              d="M132 88 h8 a13 13 0 0 1 0 26 h-8"
              stroke="#d6d3d1"
              stroke-width="7"
              fill="none"
              stroke-linecap="round"></path>
            <rect x="66" y="80" width="68" height="46" rx="10" fill="#ffffff"></rect>
            <rect
              x="66"
              y="80"
              width="68"
              height="46"
              rx="10"
              fill="none"
              stroke="#d6d3d1"
              stroke-width="2.5"></rect>
            <ellipse cx="100" cy="80" rx="34" ry="9" fill="#92400e"></ellipse>
            <ellipse cx="100" cy="78.5" rx="27" ry="6.5" fill="#b45309"></ellipse>
          </svg>
        </div>
        <figcaption
          class="font-display text-ink-soft absolute bottom-1.5 left-0 w-full text-center text-[10px] font-medium sm:bottom-2.5 sm:text-xs"
        >
          coffee first
        </figcaption>
      </figure>
    </div>
  </div>
</div>
