---
import { projects } from "../../data/projects";
import { getPublishedLessons, lessonUrl, lessonsOf } from "../../utils/lessons";

const year = new Date().getFullYear();
const all = await getPublishedLessons();
const groups = projects
  .map((project) => ({ project, lessons: lessonsOf(all, project.slug) }))
  .filter((group) => group.lessons.length > 0);
---

<footer class="border-line mt-24 border-t">
  <div
    class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]"
  >
    <div>
      <p class="font-display text-lg font-semibold">
        Jom<span class="text-brand">Mula</span>
      </p>
      <p class="text-ink-soft mt-2 max-w-xs text-sm leading-relaxed">
        A laid-back tutorial. Understand the flow first, code later. Bit by
        bit, and it all adds up.
      </p>
    </div>
    <div>
      <p class="font-display text-sm font-semibold tracking-wide uppercase">
        Lessons
      </p>
      {
        groups.map(({ project, lessons }) => (
          <div class="mt-3">
            <p class="text-ink-soft/70 text-[11px] font-bold tracking-widest uppercase">
              {project.title}
            </p>
            <ul class="mt-1.5 space-y-2 text-sm">
              {lessons.map((lesson) => (
                <li>
                  <a
                    href={lessonUrl(lesson)}
                    class="text-ink-soft hover:text-brand font-bold transition-colors"
                  >
                    {String(lesson.data.order).padStart(2, "0")} · {lesson.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div>
      <p class="font-display text-sm font-semibold tracking-wide uppercase">
        Built with
      </p>
      <ul class="text-ink-soft mt-3 space-y-2 text-sm">
        <li>Astro + React</li>
        <li>Tailwind CSS</li>
        <li>Demos you can actually click</li>
      </ul>
    </div>
  </div>
  <div class="border-line/70 border-t">
    <p class="text-ink-soft mx-auto max-w-6xl px-4 py-5 text-xs sm:px-6">
      © {year} Jom Mula. Built with patience and plenty of coffee.
    </p>
  </div>
</footer>
