  "scripts": {
    "sync:plan": "node -e \"const fs=require('fs');fs.mkdirSync('public/downloads',{recursive:true});for(const f of ['master-plan.md','master-plan-safelight.md']){if(fs.existsSync(f))fs.copyFileSync(f,'public/downloads/'+f)}\"",
    "predev": "npm run sync:plan",
    "dev": "astro dev",
    "prebuild": "npm run sync:plan",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check"
  },
